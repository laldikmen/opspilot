# Copy to .env and adjust. Paths and settings only: no secrets in this file.
# Every value is optional; the defaults live in src/opspilot/config.py.

# Where the DuckDB warehouse file is written
# OPSPILOT_DUCKDB_PATH=warehouse/opspilot.duckdb

# MLflow tracking location
# MLFLOW_TRACKING_URI=http://localhost:5000

# Kaggle credentials are NOT needed for the public Olist dataset. If Kaggle ever
# asks for them, put kaggle.json in ~/.kaggle/ rather than in this repo.
